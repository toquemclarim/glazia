{
  "name": "glazia-financeiro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "npm --prefix server run start:dev",
    "dev:full": "concurrently -n WEB,API -c cyan,magenta \"npm run dev\" \"npm run dev:api\"",
    "build": "tsc -b && vite build",
    "build:api": "npm --prefix server run build",
    "build:all": "npm run build && npm run build:api",
    "deploy:web": "npm run build && firebase deploy --only hosting",
    "docs:pdf": "node scripts/generate-architecture-doc.cjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "framer-motion": "^12.42.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "oxlint": "^1.71.0",
    "pdfkit": "^0.19.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}

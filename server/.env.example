NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Em produção (Vercel): https://seu-app.vercel.app
# Várias origens: separe por vírgula
# Previews *.vercel.app: CORS_ALLOW_VERCEL_PREVIEWS=true
CORS_ALLOW_VERCEL_PREVIEWS=false

# Postgres (Supabase). Project Settings → Database → Connection string.
# Use Session pooler (IPv4) — necessário no Render Free.
DATABASE_URL=postgresql://postgres.<project-ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DB_SCHEMA=analytics
DB_CATALOG_SCHEMA=dt_catalogo
# Free tier: mantenha baixo (3–5) para não estourar conexões do pooler
DB_POOL_MAX=10
DATABASE_SSL_REJECT_UNAUTHORIZED=false

JWT_SECRET=troque-por-um-segredo-longo
JWT_EXPIRES_IN=8h

# Em production DEVE ser []
AUTH_DEMO_USERS=[{"idUser":"user-diretor-001","email":"diretor@glazia.com.br","password":"demo1234","empresaId":"empresa-demo-001","nome":"Diretor Glazia","cargo":"DIRETOR","dataNascimento":"1985-03-12"},{"idUser":"user-adm-001","email":"adm@glazia.com.br","password":"demo1234","empresaId":"empresa-demo-001","nome":"ADM Lançamentos","cargo":"ADM","dataNascimento":"1992-07-21"}]

# --- Produção / Render ---
# NODE_ENV=production
# PORT é injetado pelo Render — não fixe
# CORS_ORIGIN=https://seu-app.vercel.app
# CORS_ALLOW_VERCEL_PREVIEWS=true
# JWT_SECRET=<openssl rand -base64 48>
# AUTH_DEMO_USERS=[]
# DB_POOL_MAX=5
# Blueprint: render.yaml (raiz do repo)

NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Postgres (Supabase). Copie a URI em Project Settings > Database > Connection string.
# Use o Session pooler: aceita IPv4 e mantém conexões persistentes.
DATABASE_URL=postgresql://postgres.<project-ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DB_SCHEMA=analytics
DB_CATALOG_SCHEMA=dt_catalogo
DB_POOL_MAX=10
# true = valida certificado TLS do Postgres (preferível em produção se possível)
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# JWT multi-tenant
# Em development: mínimo 16 caracteres.
# Em production: mínimo 32 caracteres e NÃO use valores de exemplo.
JWT_SECRET=troque-por-um-segredo-longo
JWT_EXPIRES_IN=8h

# Seed LOCAL de usuários (apenas NODE_ENV=development|test).
# Em production DEVE ser [] — a API recusa subir se houver entradas.
# Campos: idUser, email, password, empresaId, nome, cargo, dataNascimento?
AUTH_DEMO_USERS=[{"idUser":"user-diretor-001","email":"diretor@glazia.com.br","password":"demo1234","empresaId":"empresa-demo-001","nome":"Diretor Glazia","cargo":"DIRETOR","dataNascimento":"1985-03-12"},{"idUser":"user-adm-001","email":"adm@glazia.com.br","password":"demo1234","empresaId":"empresa-demo-001","nome":"ADM Lançamentos","cargo":"ADM","dataNascimento":"1992-07-21"}]

# Ops console: em development o seed cria ops@glazia.com.br / demo1234 (cargo PLATFORM)
# Acesso: http://localhost:5173/ops/login

# --- Produção (exemplo) ---
# NODE_ENV=production
# JWT_SECRET=<gere com: openssl rand -base64 48>
# AUTH_DEMO_USERS=[]
# Crie o usuário PLATFORM manualmente (empresa glazia-platform)
